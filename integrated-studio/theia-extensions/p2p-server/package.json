{
  "private": true,
  "name": "integrated-studio-p2p-server",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "description": "통합 작업실 M10 — P2P 서버 열기(hyperdht 홀펀칭 터널)",
  "files": [
    "lib",
    "src"
  ],
  "theiaExtensions": [
    {
      "frontend": "lib/browser/p2p-frontend-module",
      "backend": "lib/node/p2p-backend-module"
    }
  ],
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "blind-relay": "^1.6.1",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdht": "^6.36.0",
    "integrated-studio-launcher-core": "0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "rimraf": "6.1.4",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "watch": "tsc -w",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./lib/common": "./lib/common/index.js",
    "./lib/node/p2p-core": "./lib/node/p2p-core.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./*": "./*"
  }
}
