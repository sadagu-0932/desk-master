{
  "private": true,
  "name": "integrated-studio-electron",
  "productName": "통합 작업실",
  "version": "0.0.1",
  "description": "마인크래프트 실행 · 데이터팩 · 모드 · 리소스팩",
  "license": "UNLICENSED",
  "main": "scripts/studio-main.mjs",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "통합 작업실",
        "defaultTheme": "integrated-studio-dark",
        "defaultIconTheme": "theia-file-icons",
        "preferences": {
          "files.enableTrash": true,
          "security.workspace.trust.enabled": false,
          "workbench.colorTheme": "integrated-studio-dark",
          "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/node_modules/**": true,
            "**/saves/**": true,
            "**/logs/**": true,
            "**/crash-reports/**": true,
            "**/screenshots/**": true,
            "**/servers/*/world/**": true,
            "**/servers/*/libraries/**": true,
            "**/servers/*/logs/**": true,
            "**/.gradle/**": true,
            "**/build/**": true,
            "**/.fabric/**": true
          }
        },
        "electron": {
          "windowOptions": {
            "title": "통합 작업실"
          }
        },
        "defaultLocale": "ko"
      }
    },
    "backend": {
      "config": {
        "startupTimeout": -1
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@theia/ai-chat": "1.77.0",
    "@theia/ai-chat-ui": "1.77.0",
    "@theia/ai-claude-code": "1.77.0",
    "@theia/ai-core": "1.77.0",
    "@theia/bulk-edit": "1.77.0",
    "@theia/callhierarchy": "1.77.0",
    "@theia/console": "1.77.0",
    "@theia/core": "1.77.0",
    "@theia/debug": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/editor-preview": "1.77.0",
    "@theia/electron": "1.77.0",
    "@theia/file-search": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/keymaps": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/outline-view": "1.77.0",
    "@theia/output": "1.77.0",
    "@theia/plugin-ext": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/scm": "1.77.0",
    "@theia/search-in-workspace": "1.77.0",
    "@theia/task": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "integrated-studio-datapack-tools": "0.0.1",
    "integrated-studio-launcher-core": "0.0.1",
    "integrated-studio-launcher-ui": "0.0.1",
    "integrated-studio-server-host": "0.0.1",
    "integrated-studio-resourcepack-editor": "0.0.1",
    "integrated-studio-theme": "0.0.1"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0",
    "electron": "44.9.1",
    "electron-builder": "26.18.0"
  },
  "scripts": {
    "build": "theia build --mode development",
    "rebuild": "theia rebuild:electron --cacheRoot ../..",
    "start": "theia start",
    "watch": "theia build --watch --mode development",
    "package": "electron-builder --win",
    "package:dir": "electron-builder --dir"
  },
  "theiaPluginsDir": "plugins"
}
